# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=career-dna-super-secret-jwt-and-session-key-2025
JWT_SECRET_KEY=career-dna-jwt-secret-key-change-in-production-2025
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=career_dna_ai

# Direct SQLAlchemy Database URI (fallback to SQLite if MySQL is unavailable)
# Example MySQL URI: mysql+pymysql://root:password@127.0.0.1:3306/career_dna_ai
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/career_dna_ai

# Google Gemini API Key
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Application Settings
DEBUG=True
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_AI=30 per minute
